# =====================================================================
# config.env — EL ÚNICO ARCHIVO QUE HAY QUE EDITAR
# =====================================================================
# Lo leen `run_pipeline.sh` y todos los .slrm (cada job hace
# `. ./config.env` después de situarse en la raíz). Todas las variables usan la
# forma `${VAR:-default}`, así que **lo que ya esté en el entorno GANA**: puedes
# sobreescribir cualquier cosa sin tocar este archivo, p. ej.
#
#     PY=/otro/python bash run_pipeline.sh
#     PARTITION_GPU=gpu-a100 bash run_pipeline.sh
#
# ⚠ Este archivo se ejecuta con `.` (source). Nada de comandos aquí dentro: solo
#   asignaciones. Un `echo` rompería `sbatch --parsable`, que parsea stdout.
# =====================================================================

# ── 1 · INTÉRPRETE ────────────────────────────────────────────────────────────
# Por defecto, el .venv de ESTA carpeta, que crea `bash setup_venv.sh`.
#
# La ruta se resuelve contra la ubicación de este archivo, no contra el cwd: los
# .slrm hacen `cd` antes de leerlo, pero si alguien lo carga desde otro sitio
# `$(pwd)` apuntaría a cualquier parte.
_CFG_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-./config.env}")" && pwd)"
PY="${PY:-$_CFG_DIR/.venv/bin/python}"

# ⚠ SIEMPRE RUTA ABSOLUTA, nunca `python` a secas ni `source .venv/bin/activate`
# dentro de un job. En los nodos de cómputo, activar un entorno FALLA EN
# SILENCIO y `python` cae al intérprete equivocado: el LSTM acaba entrenando en
# CPU (~29 min/época con la GPU asignada ociosa) y el job termina EN VERDE. Es
# la trampa que más caro ha salido en este proyecto.
# Llamar a .venv/bin/python por ruta absoluta funciona sin activar nada: el venv
# se reconoce por su `pyvenv.cfg`, no por la variable VIRTUAL_ENV (que los .slrm
# desactivan a propósito, para que un entorno activo en la shell que envía el
# job no se cuele por --export=ALL).
#
# El intérprete debe traer: polars, numpy, scipy, pyarrow, h3, matplotlib,
# xgboost, scikit-learn y TensorFlow con soporte ROCm. Ver ENVIRONMENT.md.
#
# Alternativa: el env de conda de las corridas de julio, si sigue vivo —
#   PY=/lustre/home/usuario/.conda/envs/tf-local/bin/python

# ── 2 · SLURM: proyecto, particiones y recursos ──────────────────────────────
# Proyecto de cómputo. Desde el 2026-09-07 el clúster RECHAZA todo job sin
# `--account`; `misproyectos` lista los tuyos (p###, o curso##/acarus## si es de
# un curso). `run_pipeline.sh` lo pasa a cada sbatch. Los .slrm llevan además
# `#SBATCH --account=pXXX` para que un sbatch suelto tampoco rebote: si cambias
# el proyecto aquí, cámbialo también en esas líneas
# (`grep -n account jobs/*.slrm`).
ACCOUNT="${ACCOUNT:-pXXX}"

# Verificado en el clúster el 2026-08-10 con `sinfo -h -o '%P %G' | sort -u`:
#     cpu* (null)
#     gpu  gpu:MI210:2
# O sea: partición `cpu` (la de por defecto, de ahí el *) y `gpu` con dos MI210
# por nodo. `run_pipeline.sh` vuelve a comprobar los nombres contra sinfo antes
# de encolar nada, así que si esto se queda rancio te lo dirá.
PARTITION_CPU="${PARTITION_CPU:-cpu}"
PARTITION_GPU="${PARTITION_GPU:-gpu}"

# Con el TIPO explícito, que es lo que usaban los jobs de julio. En este clúster
# `gpu:1` también vale —solo hay un tipo de GPU— pero nombrarlo no cuesta nada y
# evita sorpresas si algún día se añade otro modelo a la misma partición.
GPU_GRES="${GPU_GRES:-gpu:MI210:1}"
ROCM_MODULE="${ROCM_MODULE:-rocm/6.4.3}" # `module load` de la fase GPU

# Memoria de la fase 0 (datos). En julio, con el pipeline de entonces, hacían falta
# hasta 96G. En el piloto de la vuelta (7-oct-2026, enero–agosto) el pico fue de
# 3.4 GB, en la 601, y la ruta con más crudo (401) trae 1.7 veces el de la 601:
# 32G deja más de cinco veces de holgura y entra antes a la cola. Si una ruta
# muere por memoria: `MEM_DATA=96G bash run_pipeline.sh` (manda el entorno).
MEM_DATA="${MEM_DATA:-32G}"
CPUS_DATA="${CPUS_DATA:-8}"
TIME_DATA="${TIME_DATA:-24:00:00}"

# ── 3 · VENTANA Y RÉGIMEN (el del paper; no cambiar para reproducir) ──────────
# MODE=full  →  ventana 2024-01-01 … 2024-09-01, etiqueta `2024_01-08`
#               (son ENERO–AGOSTO 2024, ~242 días; NO la semana 1-8 de enero)
# TERMINALS=AUTO_min → descubrimiento automático de terminales, etiqueta `tmin`
#               NUNCA `1`: fuerza 1 terminal y todas las legs salen self-loop.
MODE="${MODE:-full}"
TERMINALS="${TERMINALS:-AUTO_min}"
RANGE="${RANGE:-2024_01-08_tmin}"        # = BUS_ANALYSIS_RANGE aguas abajo
BUS_ANALYSIS_RANGE="${BUS_ANALYSIS_RANGE:-$RANGE}"

# Régimen de evaluación. q=0.05 + cov=1.0 es la decisión del 2026-07-24:
#   · q=0.05  → la grid se fija al P05 de longitud ⇒ retiene ~94% de los viajes
#               (con q=0.95 medías sobre el ~7% MÁS LARGO de cada leg).
#   · cov=1.0 → np.interp SATURA en vez de extrapolar; con 0.99 fabricaba target
#               en las últimas celdas y rompía los cortes del LSTM.
#   · max_trips=2500 → KNN y kernel son O(M²·l); sin tope, con q=0.05 su coste
#               se multiplica por ~200×. Submuestrea ANTES de la CV, igual para
#               TODOS los algoritmos, así que la comparación sigue pareada.
Q="${Q:-0.05}"
COV="${COV:-1.0}"
MAX_TRIPS="${MAX_TRIPS:-2500}"
TAG="${TAG:-q05c100}"                    # etiqueta de régimen = eval_frame.q_tag(Q,COV)

# ⚠ El TAG tiene que llevar el régimen COMPLETO. Si cambias Q o COV y dejas el
#   TAG viejo, la reanudación da por hechos artefactos de OTRO régimen y los
#   salta como `cached`. Eso costó una corrida entera. Regla de q_tag:
#     cov == 0.99  →  qNN            (p. ej. q05)
#     cov != 0.99  →  qNNcCCC        (p. ej. q05c100 para q=0.05, cov=1.00)

# ── 4 · CONCURRENCIA DE LOS ARRAYS ────────────────────────────────────────────
# El sufijo `%N` de --array limita cuántas tareas corren a la vez.
# Con la vuelta (rama `vuelta`): las 35 rutas en los tres tipos de array, con el
# mismo índice → ruta (jobs/*.slrm). Cada ruta tiene UNA leg, `T0->T0`.
# (En agosto: datos 0-26%6 con la 902 al final, CPU 0-25%8 y GPU 0-21%4 sin las
# 4 rutas N=1.)
DATA_ARRAY="${DATA_ARRAY:-0-34%6}"       # 35 rutas
CPU_ARRAY="${CPU_ARRAY:-0-34%8}"         # 35 rutas
GPU_ARRAY="${GPU_ARRAY:-0-34%4}"         # 35 rutas. Vale para CADA uno de los dos
                                         # arrays de LSTM (es15, tw): hasta 2×4 GPUs
                                         # a la vez.

# ── 5 · DATOS DE ENTRADA ──────────────────────────────────────────────────────
# Etiqueta del extracto raw a usar. Vacío = AUTO: por ruta se elige el parquet
# más grande de data/01_raw/records/<ruta>/ (prefiere `2024_01-12` si está).
RAW_DATE_RANGE="${RAW_DATE_RANGE:-}"

# Raíz de datos para los jobs auxiliares. Por defecto, el data/ de esta carpeta.
DATA_ROOT="${DATA_ROOT:-$(pwd)/data}"

# ── 6 · CACHÉ ─────────────────────────────────────────────────────────────────
# FORCE=0 → pasa `--no-force`: la fase 0 reusa lo que ya haya calculado. En una
# carpeta LIMPIA no hay nada que reusar, así que es gratis y hace que reenviar
# tras un timeout resuma en vez de empezar de cero.
# FORCE=1 → recalcula todo. Necesario SOLO si cambiaste código del corte de
# viajes: el manifest del caché invalida por PARÁMETROS, no por cambios de
# código.
FORCE="${FORCE:-0}"

# ── 7 · MÉTODO DE VIAJES (v2 y la vuelta, oct 2026 — docs/HANDOFF_METODO_V2.md) ─────
# Los lee el código del entorno (func/lib/_lib_new_trips.py, func/run_new_pipeline.py),
# así que van con `export`. Los valores de abajo son LA VUELTA, la corrida que fija
# docs/PREREGISTRO_VUELTA.md. Para las otras:
#   v2 con el corte de siempre:  TRIP_CUT= GRID_AXIS=recorrido TERMINAL_RULE=dwell TERMINALS_FILE=
#   la corrida tmin publicada:   lo anterior y además
#                                COHERENT_PROJECTION=0 CYCLIC_ORDER=v1 COVERAGE_BY_LEG=0
#   (o el run_pipeline.sh de la rama `metodo-v2`, que todavía encola el LSTM `es0`)
# Cada cambio de método va en una carpeta NUEVA (el caché de viajes sí invalida por
# estos valores, nt.method_tag(), pero los modelos no saben de ellos).
export COHERENT_PROJECTION="${COHERENT_PROJECTION:-1}"   # proyección coherente en el tiempo
export CYCLIC_ORDER="${CYCLIC_ORDER:-v2}"                # v1 | v2 | v2-sin-ciclo
export COVERAGE_BY_LEG="${COVERAGE_BY_LEG:-1}"           # cobertura mínima según la leg
# Terminales: dwell (las de la corrida publicada) | file (las de TERMINALS_FILE, un JSON
# {ruta: [[lat, lon], …]}, o [[lat, lon, km]] con el corte por cruce).
export TERMINAL_RULE="${TERMINAL_RULE:-file}"
# Los puntos de corte de la vuelta, uno por ruta (cortes/README.md). run_pipeline.sh
# comprueba que cubran todas las rutas con crudo: una que falte caería a dwell.
export TERMINALS_FILE="${TERMINALS_FILE:-$_CFG_DIR/cortes/cortes_vuelta.json}"
# Corte: vacío = el de siempre (registro más cercano a la terminal) | cruce = cuando el
# progreso del bus pasa por el km de cada punto de TERMINALS_FILE (entonces cada punto va
# como [lat, lon, km]; con uno por ruta el viaje es la vuelta). Necesita TERMINAL_RULE=file.
# Comparativo_metodos_viajes.md §10 (en la carpeta del proyecto).
export TRIP_CUT="${TRIP_CUT:-cruce}"
# Eje de la malla del frame: recorrido = la suma de líneas rectas entre registros (lo de
# siempre) | traza = el avance sobre la traza desde el primer registro del viaje, y los
# viajes con atajo fuera de los modelos. `traza` necesita TRIP_CUT=cruce. Ver
# run_new_pipeline.py («EJE DE LA MALLA») y el pre-registro §2.
export GRID_AXIS="${GRID_AXIS:-traza}"
